{
  "fallbackBrowserID": "com.apple.Safari",
  "rules": [
    {
      "pattern": "localhost",
      "browserID": "com.google.Chrome"
    },
    {
      "pattern": "github.com/nyaruka/*",
      "browserID": "com.google.Chrome",
      "profile": "Profile 1"
    },
    {
      "pattern": "*.atlassian.net",
      "browserID": "com.google.Chrome",
      "profile": "Profile 1"
    },
    {
      "pattern": "docs.google.com",
      "browserID": "com.google.Chrome",
      "privateWindow": true
    },
    {
      "sourceApp": "com.tinyspeck.slackmacgap",
      "browserID": "com.apple.Safari"
    }
  ]
}
