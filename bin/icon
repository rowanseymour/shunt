#!/bin/bash
# Regenerates the app's icon assets from their SVG sources using only built-in
# macOS tools (NSImage via swift to rasterize, sips to scale, iconutil to pack):
#   Support/AppIcon.svg     -> Support/AppIcon.icns
#   Support/MenuBarIcon.svg -> Support/MenuBarIcon.png + @2x (template image)
set -euo pipefail
cd "$(dirname "$0")/.."

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Rasterizes an SVG to a square PNG, preserving transparency (qlmanage would
# composite onto an opaque white background, which breaks template images).
rasterize() { # <svg> <size> <out.png>
    swift - "$1" "$2" "$3" <<'EOF'
import AppKit
let args = CommandLine.arguments
guard let svg = NSImage(contentsOfFile: args[1]), let size = Int(args[2]) else {
    fatalError("cannot read \(args[1])")
}
let rep = NSBitmapImageRep(
    bitmapDataPlanes: nil, pixelsWide: size, pixelsHigh: size, bitsPerSample: 8,
    samplesPerPixel: 4, hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB,
    bytesPerRow: 0, bitsPerPixel: 0)!
NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
svg.draw(in: NSRect(x: 0, y: 0, width: size, height: size))
try! rep.representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: args[3]))
EOF
}

MASTER="$TMP/AppIcon.png"
rasterize Support/AppIcon.svg 1024 "$MASTER"

ICONSET="$TMP/AppIcon.iconset"
mkdir "$ICONSET"
for SIZE in 16 32 128 256 512; do
    sips -z "$SIZE" "$SIZE" "$MASTER" --out "$ICONSET/icon_${SIZE}x${SIZE}.png" >/dev/null
    DOUBLE=$((SIZE * 2))
    sips -z "$DOUBLE" "$DOUBLE" "$MASTER" --out "$ICONSET/icon_${SIZE}x${SIZE}@2x.png" >/dev/null
done

iconutil -c icns "$ICONSET" -o Support/AppIcon.icns

rasterize Support/MenuBarIcon.svg 18 Support/MenuBarIcon.png
rasterize Support/MenuBarIcon.svg 36 Support/MenuBarIcon@2x.png

echo "Wrote Support/AppIcon.icns and Support/MenuBarIcon(@2x).png"
