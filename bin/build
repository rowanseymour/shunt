#!/bin/bash
# Builds Shunt.app into build/ using only the command line tools (no Xcode required).
set -euo pipefail
cd "$(dirname "$0")/.."

CONFIG="${1:-release}"
swift build -c "$CONFIG"

BIN="$(swift build -c "$CONFIG" --show-bin-path)"
APP="build/Shunt.app"

rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$BIN/Shunt" "$APP/Contents/MacOS/Shunt"
cp Support/Info.plist "$APP/Contents/Info.plist"
cp Support/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
cp Support/MenuBarIcon.png Support/MenuBarIcon@2x.png "$APP/Contents/Resources/"

# Stamp the version from the latest tag, e.g. "0.2.0", or "0.2.0-3-gf155401" between releases.
VERSION="$(git describe --tags 2>/dev/null | sed 's/^v//')" || true
if [[ -n "$VERSION" ]]; then
    /usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $VERSION" "$APP/Contents/Info.plist"
fi

codesign --force --sign - "$APP"

echo "Built $APP"
